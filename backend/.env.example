NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/quetta_bicycles
JWT_SECRET=replace_with_at_least_32_random_characters_from_a_password_manager
JWT_EXPIRES_IN=15m
# Comma-separated allowed frontend origins. Production domains are also safely included by default.
ALLOWED_ORIGINS=https://quettabikesclub.com,https://www.quettabikesclub.com
# Optional: comma-separated resolvers when a network blocks mongodb+srv DNS queries
DNS_SERVERS=1.1.1.1,8.8.8.8
WHATSAPP_BUSINESS_NUMBER=923XXXXXXXXX
DELIVERY_CHARGE_PKR=0
# Optional account used for the 20% COD advance.
COD_ADVANCE_PAYMENT_PROVIDER=
COD_ADVANCE_PAYMENT_ACCOUNT_TITLE=
COD_ADVANCE_PAYMENT_ACCOUNT_NUMBER=
COD_ADVANCE_PAYMENT_IBAN=
# Bank-transfer details shown when customers choose Bank transfer at checkout.
PAYMENT_EASYPAISA_ACCOUNT_TITLE=
PAYMENT_EASYPAISA_ACCOUNT_NUMBER=
PAYMENT_JAZZCASH_ACCOUNT_TITLE=
PAYMENT_JAZZCASH_ACCOUNT_NUMBER=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_TITLE=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_IBAN=
ENABLE_DEMO_CONTENT=false
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_12_character_or_longer_password
